#!/usr/bin/env bash
# Git pre-commit hook that runs build, tests, and linting via Taskfile
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
# Or: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Check if task is available
if ! command -v task &> /dev/null; then
    echo -e "${RED}Error: 'task' command not found. Please install go-task.${NC}"
    echo "Install with: go install github.com/go-task/task/v3/cmd/task@latest"
    exit 1
fi

# Run build
echo -e "${YELLOW}Building...${NC}"
if task build; then
    echo -e "${GREEN}Build succeeded.${NC}"
else
    echo -e "${RED}Build failed. Commit aborted.${NC}"
    exit 1
fi

# Run tests
echo -e "${YELLOW}Running tests...${NC}"
if task test; then
    echo -e "${GREEN}Tests passed.${NC}"
else
    echo -e "${RED}Tests failed. Commit aborted.${NC}"
    exit 1
fi

# Run linters
echo -e "${YELLOW}Running linters...${NC}"
if task lint; then
    echo -e "${GREEN}Linting passed.${NC}"
else
    echo -e "${RED}Linting failed. Commit aborted.${NC}"
    exit 1
fi

echo -e "${GREEN}All pre-commit checks passed.${NC}"
